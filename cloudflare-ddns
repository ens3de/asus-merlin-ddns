#!/bin/sh
# DDNS runner. Shell settings are trusted; record files are data, never code.
set -f
umask 077
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
LIB_DIR="$SCRIPT_DIR/lib"

# Merlin's non-interactive DDNS hook commonly omits Entware from PATH.  Add
# its standard directories when present so jq/curl installed under /opt work
# the same way as they do in an interactive SSH session.
for DDNS_ENTWARE_DIR in /opt/bin /opt/sbin; do
    case ":${PATH:-}:" in *:"$DDNS_ENTWARE_DIR":*) ;; *)
        [ ! -d "$DDNS_ENTWARE_DIR" ] || PATH="$DDNS_ENTWARE_DIR${PATH:+:$PATH}" ;;
    esac
done
export PATH

# One public entry point: a literal first argument of "config" enters the
# configuration manager. Keeping the implementation in a module avoids mixing
# interactive state with the non-interactive updater while shipping one CLI.
case "${1:-}" in
    config)
        shift
        # Sourcing preserves the remaining config-subcommand arguments.
        # shellcheck disable=SC1090
        . "$LIB_DIR/config-manager.sh"
        exit $? ;;
    init)
        shift
        # shellcheck disable=SC1090
        . "$LIB_DIR/init-manager.sh"
        exit $? ;;
esac

. "$LIB_DIR/common.sh"
. "$LIB_DIR/sources.sh"
. "$LIB_DIR/providers.sh"

MODE=update
SELECT_TASK=
ARG_IPV4=
ARG_IPV6=
CONFIG_FILE=${CONFIG_FILE:-"$SCRIPT_DIR/cloudflare-ddns.conf"}
usage() {
    printf '%s\n' 'Usage: cloudflare-ddns init [--config FILE]' \
        '       cloudflare-ddns config [--config FILE] [COMMAND]' \
        '       cloudflare-ddns [--config FILE] [--check|--dry-run] [--task NAME]' \
        '                       [--ipv4 ADDRESS] [--ipv6 ADDRESS] [Merlin-IP]' \
        'init: interactively create the common configuration and select a Cloudflare Zone.' \
        'config: open the record manager, or run a config subcommand.' \
        '--check: validate local configuration only.' \
        '--dry-run: resolve addresses; no DNS writes, state changes or notifications.'
}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --config|--task|--ipv4|--ipv6)
            [ "$#" -ge 2 ] || { usage >&2; exit 2; }
            case "$1" in
                --config) CONFIG_FILE=$2 ;; --task) SELECT_TASK=$2 ;;
                --ipv4) ARG_IPV4=$2 ;; --ipv6) ARG_IPV6=$2 ;;
            esac
            shift 2 ;;
        --check) MODE=check; shift ;;
        --dry-run) MODE=preview; shift ;;
        --help|-h) usage; exit 0 ;;
        --*) usage >&2; exit 2 ;;
        *)
            # Merlin's DDNS UI may be set to "IPv6 update", yet observed
            # callbacks can still provide only an IPv4 argument.  Treat this
            # positional value strictly as caller-supplied data: an AAAA task
            # using source=argument updates only when an IPv6 value is truly
            # passed.  Use interface or prefix_iid for dependable router AAAA.
            case "$1" in *:*) ARG_IPV6=$1 ;; *) ARG_IPV4=$1 ;; esac; shift ;;
    esac
done
load_settings || exit 2
require_tools jq mktemp || exit 2
[ -z "$SELECT_TASK" ] || valid_task_name "$SELECT_TASK" || die 'Invalid task name'
WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/ddns-run.XXXXXX") || exit 1
LOCK_HELD=0
cleanup() {
    [ "$LOCK_HELD" -eq 0 ] || release_config_lock
    # Generated by mktemp above, never supplied by configuration.
    [ -z "$WORK_DIR" ] || rm -rf -- "$WORK_DIR"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM HUP
acquire_config_lock || exit 1
LOCK_HELD=1
validate_directory "$CONF_DIR" || exit 2
snapshot_tasks "$WORK_DIR/tasks.jsonl" || exit 2
if [ "$MODE" = check ]; then
    printf '%s\n' 'Configuration valid (including disabled tasks). No network requests made.'
    exit 0
fi
require_tools curl || exit 2
if [ "$MODE" = update ]; then
    provider_validate_settings || exit 2
    state_load "$WORK_DIR/state.json" || exit 2
fi
FAILED=0
PROCESSED=0
while IFS= read -r task; do
    enabled=$(printf '%s\n' "$task" | jq -r '.record.enabled')
    if [ "$enabled" != true ]; then
        [ "$MODE" = preview ] && [ -n "$SELECT_TASK" ] || continue
    fi
    task_name=$(printf '%s\n' "$task" | jq -r '.task')
    record=$(printf '%s\n' "$task" | jq -c '.record')
    domain=$(printf '%s\n' "$record" | jq -r '.name | ascii_downcase | rtrimstr(".")')
    provider=$(printf '%s\n' "$record" | jq -r '.provider')
    for family in A AAAA; do
        definition=$(printf '%s\n' "$record" | jq -c --arg f "$family" '.[$f] // empty')
        [ -n "$definition" ] || continue
        PROCESSED=$((PROCESSED + 1))
        label="$task_name/$family"
        id=$(printf '%s\n' "$definition" | jq -r '.id')
        source=$(printf '%s\n' "$definition" | jq -c '.source')
        if ! address=$(resolve_source "$family" "$source"); then
            log error "$label: address resolution failed; DNS left unchanged"
            FAILED=$((FAILED + 1)); continue
        fi
        if [ "$MODE" = preview ]; then
            jq -nc --arg task "$task_name" --arg name "$domain" --arg type "$family" \
                --arg ip "$address" --argjson source "$source" \
                '{task:$task,name:$name,type:$type,source:$source,address:$ip}'
            continue
        fi
        state_key="$provider/$CF_ZONE_ID/$id/$family/$domain"
        if state_is_fresh "$WORK_DIR/state.json" "$state_key" "$address"; then
            log info "$label: unchanged within refresh interval"; continue
        fi
        if provider_update "$provider" "$id" "$domain" "$family" "$address"; then
            if state_store "$WORK_DIR/state.json" "$state_key" "$address"; then
                log info "$label: updated $domain -> $address"
            else
                log error "$label: DNS updated but state could not be saved"
                FAILED=$((FAILED + 1))
            fi
        else
            log error "$label: provider update failed; successful state not recorded"
            FAILED=$((FAILED + 1))
        fi
    done
done < "$WORK_DIR/tasks.jsonl"
if [ "$MODE" = update ]; then
    if [ "$FAILED" -eq 0 ]; then notify_merlin 1
    else
        notify_merlin 0
        send_bark "DDNS: $FAILED failed record(s), $PROCESSED processed. Check router logs."
    fi
fi
[ "$FAILED" -eq 0 ]
