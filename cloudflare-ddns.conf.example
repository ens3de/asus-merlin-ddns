# Illustrative output for "cloudflare-ddns init". Do not edit placeholders into production.
# Common settings only. This is trusted shell; keep it private (chmod 600).
# Record files are created by "cloudflare-ddns config", not sourced as shell.
CF_API_TOKEN="REPLACE_WITH_SCOPED_TOKEN"
CF_ZONE_ID="REPLACE_WITH_ZONE_ID"

# These defaults are relative to the installed script directory.
CONF_DIR="$SCRIPT_DIR/conf.d"
STATE_FILE="$SCRIPT_DIR/cloudflare-ddns.state"
LOG_LEVEL="info"
LOG_TAG="cloudflare-ddns"
# LOG_FILE="/jffs/scripts/ddns/ddns.log"

# Unchanged addresses are resubmitted after this interval, not polled at it.
REFRESH_INTERVAL_SECONDS="43200"
HTTP_CONNECT_TIMEOUT_SECONDS="5"
HTTP_TIMEOUT_SECONDS="10"

# Optional aggregate failure notification. Never put these in record JSON.
BARK_URL="https://api.day.app"
BARK_KEY=""
BARK_TITLE="cloudflare-ddns"
BARK_GROUP=""
